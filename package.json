{
  "name": "campusnet-analyzer-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CampusNet Analyzer - University Campus E-Learning Network Performance Simulator",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend test",
    "backend": "backend\\venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "test": "backend\\venv\\Scripts\\python.exe -m pytest backend/tests"
  }
}
